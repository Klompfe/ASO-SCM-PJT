# 데이터베이스 설정
# DB_TYPE=sqlite 이면 DB_DATABASE만 파일 경로로 사용, 그 외(postgres)는 아래 DB_HOST 이하 값 사용
DB_TYPE=sqlite
DB_DATABASE=scm_db.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
# Neon 등 관리형 Postgres는 SSL이 필수 — DB_TYPE=postgres일 때 true로 설정
DB_SSL=false

# 서버 설정
PORT=3000
# 프로덕션에서는 반드시 production으로 설정 — TypeORM synchronize가 꺼지고
# 마이그레이션으로만 스키마를 관리한다(docs/DEPLOYMENT.md 참고)
NODE_ENV=development
# 허용할 프론트엔드 origin (콤마로 여러 개 구분 가능). 미설정 시 로컬 개발용 localhost만 허용
CORS_ORIGIN=

# JWT 인증 설정 (필수 - 미설정 시 서버가 기동되지 않음)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h

# 작업지시서 이미지/PDF AI 분석 (Gemini) - 미설정 시 VisionService가 목업 데이터를 반환
GEMINI_API_KEY=
